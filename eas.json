{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.25:3000",
        "EXPO_PUBLIC_SOCKET_URL": "http://192.168.1.25:3000"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tu-backend-produccion.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://tu-backend-produccion.com"
      }
    }
  }
}
